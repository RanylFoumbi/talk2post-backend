# ===========================================
# Server Configuration
# ===========================================
PORT=8000
NODE_ENV=development

# Secret used to authenticate Vercel Cron Job requests
  7 +CRON_SECRET=your-cron-secret

# ===========================================
# Supabase (Database & Authentication)
# ===========================================
# Project URL from Supabase dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
# Public anon key (safe to expose client-side)
SUPABASE_ANON_KEY=your-anon-key
# Service role key (server-side only, full database access)
SUPABASE_SERVICE_KEY=your-service-key

# ===========================================
# OpenAI (Transcription & Content Generation)
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key

# ===========================================
# LemonSqueezy (Payments & Subscriptions)
# ===========================================
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
# Secret used to verify incoming webhook signatures
LEMONSQUEEZY_WEBHOOK_SECRET=

# ===========================================
# Sentry (Error Tracking & Monitoring)
# ===========================================
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

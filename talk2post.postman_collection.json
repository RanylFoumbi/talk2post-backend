{
  "info": {
    "name": "Talk2Post API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api" },
    { "key": "postId", "value": "" },
    { "key": "recordingId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Preferences",
      "item": [
        {
          "name": "Get Preferences",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/preferences", "host": ["{{baseUrl}}"], "path": ["preferences"] }
          }
        },
        {
          "name": "Upsert Preferences",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{baseUrl}}/preferences", "host": ["{{baseUrl}}"], "path": ["preferences"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"writing_style\": \"storytelling\",\n  \"language\": \"en\",\n  \"role\": \"Founder\",\n  \"industry\": \"SaaS\",\n  \"audience\": \"Entrepreneurs\",\n  \"goal\": \"Build authority\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Recordings",
      "item": [
        {
          "name": "Transcribe Audio",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "  pm.collectionVariables.set('recordingId', res.id);",
                  "  console.log('Saved recordingId:', res.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/recordings/transcribe", "host": ["{{baseUrl}}"], "path": ["recordings", "transcribe"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "audio", "type": "file", "src": "" },
                { "key": "language", "value": "en", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "List Recordings",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/recordings", "host": ["{{baseUrl}}"], "path": ["recordings"] }
          }
        },
        {
          "name": "Get Recording by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/recordings/{{recordingId}}", "host": ["{{baseUrl}}"], "path": ["recordings", "{{recordingId}}"] }
          }
        },
        {
          "name": "Update Recording",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/recordings/{{recordingId}}", "host": ["{{baseUrl}}"], "path": ["recordings", "{{recordingId}}"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transcript\": \"Updated transcript text\",\n  \"language\": \"en\"\n}"
            }
          }
        },
        {
          "name": "Delete Recording",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/recordings/{{recordingId}}", "host": ["{{baseUrl}}"], "path": ["recordings", "{{recordingId}}"] }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Generate from Recording (voice-first)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const lines = pm.response.text().trim().split('\\n');",
                  "const lastLine = JSON.parse(lines[lines.length - 1]);",
                  "if (lastLine.post && lastLine.post.id) {",
                  "  pm.collectionVariables.set('postId', lastLine.post.id);",
                  "  console.log('Saved postId:', lastLine.post.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/posts/generate", "host": ["{{baseUrl}}"], "path": ["posts", "generate"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recordingId\": \"{{recordingId}}\",\n  \"writingStyle\": \"storytelling\"\n}"
            }
          }
        },
        {
          "name": "Generate from Manual Text",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const lines = pm.response.text().trim().split('\\n');",
                  "const lastLine = JSON.parse(lines[lines.length - 1]);",
                  "if (lastLine.post && lastLine.post.id) {",
                  "  pm.collectionVariables.set('postId', lastLine.post.id);",
                  "  console.log('Saved postId:', lastLine.post.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/posts/generate", "host": ["{{baseUrl}}"], "path": ["posts", "generate"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transcript\": \"Today I want to talk about building in public and how it changed my startup journey. When I started sharing my progress openly, everything shifted. People started reaching out, investors noticed, and my community grew organically. The key lesson is that vulnerability builds trust faster than polished marketing ever could.\",\n  \"writingStyle\": \"professional\"\n}"
            }
          }
        },
        {
          "name": "Regenerate (same recording, different style)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const lines = pm.response.text().trim().split('\\n');",
                  "const lastLine = JSON.parse(lines[lines.length - 1]);",
                  "if (lastLine.post && lastLine.post.id) {",
                  "  pm.collectionVariables.set('postId', lastLine.post.id);",
                  "  console.log('Saved postId:', lastLine.post.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/posts/generate", "host": ["{{baseUrl}}"], "path": ["posts", "generate"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recordingId\": \"{{recordingId}}\",\n  \"writingStyle\": \"casual\",\n  \"authorContext\": {\n    \"role\": \"CTO\",\n    \"industry\": \"Tech\",\n    \"audience\": \"Engineering leaders\",\n    \"goal\": \"Share leadership insights\"\n  }\n}"
            }
          }
        },
        {
          "name": "List Posts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/posts?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["posts"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Post by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["posts", "{{postId}}"] }
          }
        },
        {
          "name": "Toggle Favorite",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["posts", "{{postId}}"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_favorite\": true\n}"
            }
          }
        },
        {
          "name": "Mark as Copied",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["posts", "{{postId}}"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"copied\": true\n}"
            }
          }
        },
        {
          "name": "Update Post Content",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["posts", "{{postId}}"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Updated post content here.\"\n}"
            }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["posts", "{{postId}}"] }
          }
        }
      ]
    }
  ]
}

{
  "name": "talk2post-backend",
  "version": "1.0.0",
  "description": "Talk2Post backend - Node.js Express TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --expose-gc src/server.ts",
    "build": "tsc",
    "start": "node --expose-gc dist/server.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@sentry/node": "^10.43.0",
    "@sentry/profiling-node": "^10.43.0",
    "@supabase/supabase-js": "^2.49.1",
    "ai": "^6.0.116",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-schedule": "^2.1.1",
    "openai": "^6.32.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "@types/node-schedule": "^2.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
